__pycache__/

# .claude/ is the committed toolkit (skills, subagents, hooks, settings.json) —
# version-controlled so the team shares it and it survives a topic fork. Only
# the per-machine local overrides (settings.local.json) are ignored.
.claude/settings.local.json

# Video primary sources — kept locally per manifest entries (source URL,
# Wayback-backed; re-fetchable) but excluded from git remote due to file-size limits. Already-tracked
# small videos (e.g., the 5.6 MB FLIR1 file) stay tracked because
# gitignore does not retroactively untrack files; new additions need
# `git add -f` to override this rule.
sources/video/

# Session credentials — never commit. yt-dlp / Firefox cookies.txt files
# authenticate full Google account access (SID, SAPISID, __Secure-*PSID,
# LOGIN_INFO). The pre-commit `cookies-check` gate (scripts/tests/cookies-check.sh)
# is the defensive backstop if a renamed file slips past these patterns.
cookies.txt
yt-cookies*.txt
*.cookies.txt
*cookies.sqlite*

# yt-dlp gotcha — `--cookies -` is interpreted as a literal filename, and
# yt-dlp writes refreshed cookies back to a file named `-` in the working
# directory after the run. scripts/tools/download-video.py and transcribe.py
# avoid this by using `--cookies-from-browser firefox` and `--cookies /dev/stdin`
# respectively, but the gitignore entry is defense-in-depth in case a future
# tool or contributor command leaks via `-`. See scripts/tools/VIDEO-PIPELINE.md
# "Cookies — when, why, and the dangerous form" for the canonical workflow.
/-

# yt-dlp partial / temp / metadata artifacts. Same memory-only discipline
# concern: a future yt-dlp version or flag combination could persist
# auth-bearing state here.
*.part
*.ytdl
*.live_chat.json

# Photo-identity working area. detect-faces.py writes unlabeled face crops
# here; they're working state to be reviewed and either registered as
# baselines (which DO get committed under baselines/) or pruned. The crops/
# directory itself is tracked (via .gitkeep) so the layout is reproducible;
# only the working .jpg accumulation is excluded. See
# scripts/tools/VIDEO-PIPELINE.md and sources/photo-identity-log/README.md.
sources/photo-identity-log/crops/*.jpg
sources/photo-identity-log/crops/*.jpeg
sources/photo-identity-log/crops/*.png

# Per-session detect-faces log. Working state only — manifest.yaml is the
# authoritative baseline registry (sha256, source-video, timestamp, bbox,
# added_date for every baseline). index.csv is regenerated by detect-faces.py
# and auto-prunes rows whose crops/* paths no longer exist.
sources/photo-identity-log/index.csv

# Project-local venv for the dlib face-embedding matcher. Created by
# setup-face-embeddings.sh to comply with PEP 668 externally-managed-environment
# protection on Debian/Kali (and to isolate dlib's heavy C++ build). Both
# detect-faces.py and spot-check-attribution.py auto-relaunch under
# .venv-face/bin/python3 when it exists.
.venv-face/

# Project-local venv for the PaddleOCR engine behind the OCR-consensus
# pipeline. Created by setup-ocr-consensus.sh; ocr-consensus.py auto-relaunches
# under .venv-ocr/bin/python3 when it exists. Kept separate from .venv-face/
# because PaddleOCR's footprint is heavy.
.venv-ocr/

# Project-local venv for Playwright + Chromium behind browser-fetch.py (the
# bot-walled-asset fetcher). Created by setup-browser-fetch.sh; browser-fetch.py
# auto-relaunches under .venv-browser/bin/python3 when it exists. Kept separate
# because the bundled Chromium build is large.
.venv-browser/

# Derived baseline-encoding cache (128-d dlib embeddings of every baseline
# crop). Rebuilt on demand from the committed baselines/ via a sha256
# fingerprint — never authoritative, never committed.
sources/photo-identity-log/baseline-encodings.npz

# Local-only spot-check comparison scratch (pHash-vs-embed CSVs). Working
# evidence; the authoritative result lives in meta/BACKLOG.md's C1 table.
sources/photo-identity-log/.compare/

# API credentials — never commit. The api.data.gov / govinfo full-text search
# key(s) live in meta/API_KEYS.txt (one provider per block; see that file's
# header and meta/sources-access.md "govinfo"). The key authenticates only
# rate-limited, read-only federal-document search, but it is still a credential
# — keep it machine-local. The `*.api-keys.txt` glob is defense-in-depth for a
# renamed copy.
meta/API_KEYS.txt
*.api-keys.txt
